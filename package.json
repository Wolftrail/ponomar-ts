{
  "name": "ponomar-ts",
  "version": "0.1.0",
  "description": "TypeScript reimplementation of the Ponomar Orthodox liturgics engine.",
  "keywords": [
    "orthodox",
    "liturgy",
    "typicon",
    "pascha",
    "calendar",
    "menaion",
    "lectionary",
    "ponomar"
  ],
  "homepage": "https://github.com/Wolftrail/ponomar-ts#readme",
  "bugs": {
    "url": "https://github.com/Wolftrail/ponomar-ts/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Wolftrail/ponomar-ts.git"
  },
  "license": "GPL-3.0-or-later",
  "author": "Wolfgang Nothdurft",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./paschalion": {
      "types": "./dist/paschalion.d.ts",
      "import": "./dist/paschalion.js"
    },
    "./astronomy": {
      "types": "./dist/astronomy/astronomy.d.ts",
      "import": "./dist/astronomy/astronomy.js"
    },
    "./bible": {
      "types": "./dist/bible/reference.d.ts",
      "import": "./dist/bible/reference.js"
    },
    "./dsl": {
      "types": "./dist/core/dsl/index.d.ts",
      "import": "./dist/core/dsl/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/data/generated/**/*.map",
    "LICENSE",
    "NOTICE.md",
    "README.md",
    "LIMITATIONS.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "scripts": {
    "clean": "node --experimental-strip-types scripts/clean.ts",
    "golden": "node --experimental-strip-types scripts/golden/run.ts",
    "convert": "node --experimental-strip-types scripts/convert/index.ts",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "test": "node --test --experimental-strip-types \"tests/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "smoke": "node --experimental-strip-types scripts/smoke.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.7.0"
  }
}
