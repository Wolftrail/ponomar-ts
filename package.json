{
  "name": "ponomar-ts",
  "version": "1.0.0-rc.7",
  "description": "TypeScript port of the Ponomar Orthodox liturgics engine: paschal date math, Typicon rule dispatcher, saint & reading resolution.",
  "keywords": [
    "orthodox",
    "liturgy",
    "typicon",
    "pascha",
    "calendar",
    "menaion",
    "oktoechos",
    "church-slavic",
    "ponomar"
  ],
  "homepage": "https://github.com/wolfgangnothdurft/ponomar-ts#readme",
  "bugs": {
    "url": "https://github.com/wolfgangnothdurft/ponomar-ts/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wolfgangnothdurft/ponomar-ts.git"
  },
  "license": "GPL-3.0-or-later",
  "author": "Wolfgang Nothdurft",
  "contributors": [
    "Ponomar Java authors: Aleksandr Andreev et al. (2006-2018)"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./paschalion": {
      "types": "./dist/paschalion.d.ts",
      "import": "./dist/paschalion.js"
    },
    "./calendar/jdate": {
      "types": "./dist/core/calendar/jdate.d.ts",
      "import": "./dist/core/calendar/jdate.js"
    },
    "./calendar/pcalendar": {
      "types": "./dist/core/calendar/pcalendar.d.ts",
      "import": "./dist/core/calendar/pcalendar.js"
    },
    "./dsl": {
      "types": "./dist/core/dsl/index.d.ts",
      "import": "./dist/core/dsl/index.js"
    },
    "./data": {
      "types": "./dist/data/index.d.ts",
      "import": "./dist/data/index.js"
    },
    "./engine": {
      "types": "./dist/engine/index.d.ts",
      "import": "./dist/engine/index.js"
    },
    "./bible": {
      "types": "./dist/bible/index.d.ts",
      "import": "./dist/bible/index.js"
    },
    "./astronomy": {
      "types": "./dist/astronomy/index.d.ts",
      "import": "./dist/astronomy/index.js"
    },
    "./lives": {
      "types": "./dist/lives.d.ts",
      "import": "./dist/lives.js"
    }
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "NOTICE.md",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node --experimental-strip-types scripts/clean.ts",
    "codegen": "node --experimental-strip-types scripts/codegen/index.ts",
    "scrape:htoc": "node --experimental-strip-types scripts/scrape-htoc.ts",
    "test": "node --test --experimental-strip-types \"tests/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run codegen -- --check && npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
